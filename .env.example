# ==============================================================================
# FlexPay Environment Configuration Template
# Copy this file to .env and configure your local or sandbox credentials.
# NEVER commit .env files, actual private keys, or credentials to version control.
# ==============================================================================

# Server configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Safaricom M-PESA Ethiopia API Credentials (Sandbox)
# Obtain credentials from https://developer.safaricom.et/
SAFARICOM_ENV=sandbox
SAFARICOM_BASE_URL=https://apisandbox.safaricom.et
SAFARICOM_CLIENT_ID=your_consumer_key_here
SAFARICOM_CLIENT_SECRET=your_consumer_secret_here

# M-PESA USSD Push / Merchant Initiated configuration
SAFARICOM_SHORTCODE=2005
SAFARICOM_PASSKEY=your_sandbox_passkey_here
SAFARICOM_CALLBACK_URL=https://your-domain.ngrok-free.app/api/webhooks/mpesa/callback

# M-PESA B2C & Reversal Security Credentials (Asymmetric PKI)
# Required for B2C payouts, transaction status queries, and reversals
SAFARICOM_INITIATOR_NAME=YellowBusinessInit
SAFARICOM_SECURITY_CREDENTIAL=your_encrypted_initiator_password_here
SAFARICOM_RESULT_URL=https://your-domain.ngrok-free.app/api/webhooks/mpesa/result
SAFARICOM_TIMEOUT_URL=https://your-domain.ngrok-free.app/api/webhooks/mpesa/timeout

# Database / Storage (SQLite / PostgreSQL)
DATABASE_URL=file:./dev.db
